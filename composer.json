{
  "name": "neighborhoods/phrets",
  "type": "library",
  "license": "MIT",
  "description": "RETS library in PHP",
  "keywords": [
    "rets",
    "mls"
  ],
  "homepage": "http://github.com/neighborhoods/PHRETS",
  "require": {
    "php": ">=5.5.0",
    "guzzlehttp/guzzle": ">=6.0",
    "illuminate/container": ">=4.2.0",
    "illuminate/support": ">=4.2.0",
    "league/csv": ">=6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "5.*",
    "psr/log": "1.*",
    "monolog/monolog": "1.10.*",
    "gsaulmon/guzzlerecorder": "2.*",
    "ramsey/conventional-commits": "^1.3",
    "captainhook/captainhook": "^5.10"
  },
  "autoload": {
    "psr-4": {
      "PHRETS\\": "src/"
    }
  },
  "scripts": {
    "post-autoload-dump": "vendor/bin/captainhook install -f -s"
  },
  "extra": {
    "ramsey/conventional-commits": {
      "config": {
        "typeCase": null,
        "types": [],
        "scopeCase": null,
        "scopeRequired": false,
        "scopes": [],
        "descriptionCase": null,
        "descriptionEndMark": null,
        "bodyRequired": false,
        "bodyWrapWidth": null,
        "requiredFooters": []
      }
    }
  }
}
